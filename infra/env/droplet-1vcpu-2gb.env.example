# ---------------------------------------------------------------------------
# The droplet's .env template: DigitalOcean, 1 vCPU, 2 GB, running
# serving,proxy,tunnel (docs/deploy.md). Copy it to `.env` on the droplet, fill
# in every blank, then `make check-env TEMPLATE=infra/env/droplet-1vcpu-2gb.env.example`.
#
# Same names as .env.example, which explains each one; `make lint` fails when
# the two disagree. Only the values differ: sized for this machine, and set for
# production. Secrets, hostnames and URLs stay blank here, as everywhere.
#
# Running here, by memory ceiling: api 512m, Postgres 512m, proxy 128m, tunnel
# 128m, web 64m — about 1.3 GB, leaving the rest to the host and the page
# cache. migrate (512m) runs only while the api is stopped. Raise a limit here,
# by pull request, when `make stats` shows a service near it.
#
# Blanks `make check-env` accepts on this place: Google sign-in waits for a
# domain, and the droplet pushes no images.
# may-be-blank: GOOGLE_OAUTH_CLIENT_ID GOOGLE_OAUTH_CLIENT_SECRET GOOGLE_OAUTH_AUTHORIZE_URL GOOGLE_OAUTH_TOKEN_URL GOOGLE_OAUTH_JWKS_URL RELEASE_REGISTRY
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=production
SERVICE_NAME=careerpolaris
LOG_LEVEL=INFO
PORT=8000
# https://$SITE_HOSTNAME, written out.
CORS_ALLOWED_ORIGINS=

# --- Where this copy runs (docs/decisions/0051) -----------------------------
COMPOSE_PROFILES=serving,proxy,tunnel

# --- Ports published to the host --------------------------------------------
PUBLISHED_BIND_ADDRESS=127.0.0.1
API_PUBLISHED_PORT=21470
WEB_PUBLISHED_PORT=21471
POSTGRES_PUBLISHED_PORT=21472
S3_PUBLISHED_PORT=21473

# --- Container resources ----------------------------------------------------
# One vCPU: no ceiling above 1.0, or Docker refuses to create the container.
API_MEM_LIMIT=512m
API_CPUS=1.0
# worker and crawler run on the compute machine, never here.
WORKER_MEM_LIMIT=2g
WORKER_CPUS=1.0
CRAWLER_MEM_LIMIT=2g
CRAWLER_CPUS=1.0
MIGRATE_MEM_LIMIT=512m
MIGRATE_CPUS=1.0
# Static files only.
WEB_MEM_LIMIT=64m
WEB_CPUS=0.5
POSTGRES_MEM_LIMIT=512m
POSTGRES_CPUS=1.0
# The local S3 gateway does not run here: files are in object storage.
OBJECTSTORE_MEM_LIMIT=256m
OBJECTSTORE_CPUS=0.5
TUNNEL_MEM_LIMIT=128m
TUNNEL_CPUS=0.5
PROXY_MEM_LIMIT=128m
PROXY_CPUS=0.5
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# --- Postgres: infra container ----------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=careerpolaris
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Sized for a 512m container on a 2 GB host.
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_MAX_CONNECTIONS=50

# --- Postgres: least-privilege role passwords -------------------------------
APP_RW_PASSWORD=
CRAWLER_RW_PASSWORD=
AGGREGATOR_PASSWORD=
MIGRATOR_PASSWORD=

# --- Postgres: connection strings, one per role -----------------------------
# Host postgres:5432, each with its role's password.
DATABASE_URL=
CRAWLER_DATABASE_URL=
MIGRATOR_DATABASE_URL=
# The compute machine shares this Postgres: 3 in both places.
DB_POOL_SIZE=3
DB_STATEMENT_TIMEOUT_MS=30000

# --- Tunnel -----------------------------------------------------------------
# The tag:careerpolaris-serving auth key.
TUNNEL_AUTH_KEY=
TUNNEL_HOSTNAME=careerpolaris-serving
TUNNEL_WAIT_SECONDS=60

# --- The edge proxy ---------------------------------------------------------
# <reserved-ip>.sslip.io until there is a domain.
SITE_HOSTNAME=
EDGE_MAX_BODY_SIZE=11MB
EDGE_AUTH_REQUESTS_PER_MINUTE=10
EDGE_REQUESTS_PER_MINUTE=300
EDGE_READ_HEADER_TIMEOUT=10s
EDGE_READ_BODY_TIMEOUT=120s
EDGE_IDLE_TIMEOUT=2m

# careerpolaris_net's subnet, once `make start-infra` has created it:
#   docker network inspect careerpolaris_net -f '{{(index .IPAM.Config 0).Subnet}}'
# Left blank, compose falls back to 127.0.0.1 and every client looks like the
# proxy, so `make check-env` refuses a blank here.
FORWARDED_ALLOW_IPS=

# --- Limits per account and per address (ADR 0054) -------------------------
SIGNUPS_PER_ADDRESS_PER_DAY=10
UPLOADS_PER_ACCOUNT_PER_DAY=30
SYNCS_PER_ACCOUNT_PER_HOUR=6

# --- Releases (ADR 0055) -----------------------------------------------------
# The droplet pulls by the digests in release.env and pushes nothing.
RELEASE_REGISTRY=
RELEASE_PLATFORMS=linux/amd64,linux/arm64

# --- Database backups (make backup-db / restore-db) -------------------------
# The backup bucket and its own key.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Auth: our own sign-in ---------------------------------------------------
AUTH_JWT_SECRET=
AUTH_TOKEN_ISSUER=careerpolaris
AUTH_TOKEN_AUDIENCE=careerpolaris-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# HTTPS through Caddy.
AUTH_COOKIE_SECURE=true

# --- Login OAuth: sign in with Google (off: needs a domain) -----------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_AUTHORIZE_URL=
GOOGLE_OAUTH_TOKEN_URL=
GOOGLE_OAUTH_JWKS_URL=
# https://$SITE_HOSTNAME, written out.
AUTH_PUBLIC_API_BASE_URL=

# --- Encryption -------------------------------------------------------------
# The same key as the compute machine's. Keep a copy outside the droplet: lose
# it and every stored connector token and AI key is unreadable.
MASTER_ENCRYPTION_KEY=

# --- Object storage ---------------------------------------------------------
# The app's bucket and its own key. Both endpoints are the provider's public
# one: there is no S3 gateway on this machine.
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# --- Connector OAuth --------------------------------------------------------
# https://$SITE_HOSTNAME, written out; each OAuth app lists
# https://$SITE_HOSTNAME/connections/{github,jira}/callback.
OAUTH_REDIRECT_BASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_API_BASE_URL=https://api.atlassian.com
JIRA_OAUTH_BASE_URL=https://auth.atlassian.com

# --- AI gateway -------------------------------------------------------------
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_RETRIES=2
AI_DEFAULT_MONTHLY_BUDGET_USD=20

# --- Uploads / parsing limits ------------------------------------------------
RESUME_MAX_BYTES=10485760
RESUME_MAX_PAGES=30
OWN_POSTING_MAX_BYTES=5242880
OWN_POSTING_MAX_PAGES=10
PARSE_TIMEOUT_SECONDS=60

# --- Résumé templates ----------------------------------------------------------
RESUME_TEMPLATE_MAX=10
TEMPLATE_UPLOAD_MAX_BYTES=5242880
TEMPLATE_UPLOAD_MAX_PAGES=3

# --- Crawler ----------------------------------------------------------------
CRAWL_USER_AGENT="CareerPolarisBot/1.0 (+contact in robots policy)"
CRAWL_HTTP_TIMEOUT_SECONDS=30
CRAWL_RATE_LIMIT_PER_HOST_PER_SECOND=1
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Market on demand (ADR 0027) ---------------------------------------------
CRAWL_DUE_POLL_SECONDS=15
CRAWL_MAX_REQUESTS_PER_HOST_PER_DAY=500
MARKET_SEARCH_FRESH_HOURS=72
MARKET_BOARD_FRESH_HOURS=24
MARKET_WAIT_SECONDS=300
MARKET_SOURCE_IDLE_DAYS=90
POSTING_THIN_AFTER_DAYS=180

# --- Assessment -------------------------------------------------------------
ASSESSMENT_CONFIDENCE_THRESHOLD=0.6

# --- Role map (ADR 0029) ------------------------------------------------------
ROLE_CANDIDATE_COUNT=10
ROLE_MAP_TOP_K=10

# --- Background work ----------------------------------------------------------
JOB_STALE_AFTER_SECONDS=900
PRESENCE_HEARTBEAT_SECONDS=10

# --- SPA runtime config (reaches the browser — never put a secret here) ------
# https://$SITE_HOSTNAME, written out.
WEB_API_BASE_URL=
