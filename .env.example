# ---------------------------------------------------------------------------
# Every runtime setting the services read lives here. Copy to `.env` and fill
# in. Values differ per environment; names never do.
#
# Everything runs in containers, so hostnames are compose service names on the
# `jsa_net` network — not `localhost`. The `*_PUBLISHED_PORT` values are the
# only host-facing numbers: they are what a browser or a database client on the
# machine connects to.
#
# Rule (design-guideline/ai-context/shared-context.md): a default is allowed
# only for an optional, non-sensitive setting. Hostnames, URLs, connection
# strings and secrets are REQUIRED and fail startup when missing — they are
# left blank below.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=
SERVICE_NAME=job-searching-advisor
LOG_LEVEL=INFO
PORT=8000
# Browser origins allowed to call the API — the SPA's origin.
# Locally: http://localhost:21471 (WEB_PUBLISHED_PORT).
CORS_ALLOWED_ORIGINS=

# --- Where this copy runs (docs/decisions/0051) -----------------------------
# Which services start here, read by docker compose itself:
#   edge     api, web and Postgres (the droplet)
#   compute  worker and crawler (the machine that does the heavy work)
#   tunnel   the private link between those two
#   proxy    Caddy on 80/443, the only thing on the internet (the droplet)
#   local    MinIO; a deployment uses Spaces instead
# Development and CI run everything on one machine, with no tunnel or proxy.
# The droplet: edge,proxy,tunnel. The compute machine: compute,tunnel.
COMPOSE_PROFILES=edge,compute,local

# --- Ports published to the host --------------------------------------------
# The address every published port binds to. Loopback, because Docker's own
# iptables rules go ahead of ufw: 0.0.0.0 would put the api, Postgres and MinIO
# on the internet on any host with a public address.
PUBLISHED_BIND_ADDRESS=127.0.0.1
# This repo's block is 21470-21474: uncommon, below the OS ephemeral range, and
# never a framework or product default (8000, 5173, 5432, 9000, ...), so it can
# run beside other projects on one machine. The compose files default to these
# same numbers; change one here only if it really collides on your machine,
# then change every URL below that names it. Inside the containers the
# conventional ports stay (api 8000, web 8080, postgres 5432, minio 9000/9001).
API_PUBLISHED_PORT=21470
WEB_PUBLISHED_PORT=21471
POSTGRES_PUBLISHED_PORT=21472
S3_PUBLISHED_PORT=21473
S3_CONSOLE_PUBLISHED_PORT=21474

# --- Container resources (optional) ------------------------------------------
# Ceilings the compose files put on each container. Defaults are about twice
# each service's measured use; raise one here if `make stats` shows it near its
# ceiling or `oom_killed=true`, rather than editing the compose files. Memory
# takes docker units (768m, 2g); CPUs are cores (0.5, 2.0).
API_MEM_LIMIT=768m
API_CPUS=1.0
# Runs AI jobs, PDF renders and embeddings.
WORKER_MEM_LIMIT=2g
WORKER_CPUS=2.0
# Holds the embedding model in memory: about 1 GiB at rest.
CRAWLER_MEM_LIMIT=2g
CRAWLER_CPUS=1.0
MIGRATE_MEM_LIMIT=768m
MIGRATE_CPUS=1.0
WEB_MEM_LIMIT=512m
WEB_CPUS=0.5
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=2.0
OBJECTSTORE_MEM_LIMIT=1g
OBJECTSTORE_CPUS=1.0
TUNNEL_MEM_LIMIT=128m
TUNNEL_CPUS=0.5
PROXY_MEM_LIMIT=128m
PROXY_CPUS=0.5
# Container log rotation: each container keeps at most MAX_FILE files of
# MAX_SIZE each.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# --- Postgres: infra container ----------------------------------------------
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_SUPERUSER=
POSTGRES_SUPERUSER_PASSWORD=

# Postgres's own memory settings. These are its defaults; a 2 GB droplet takes
# shared_buffers=128MB, work_mem=4MB, effective_cache_size=512MB and
# max_connections=50.
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_WORK_MEM=4MB
POSTGRES_EFFECTIVE_CACHE_SIZE=4GB
POSTGRES_MAX_CONNECTIONS=100

# --- Postgres: least-privilege role passwords (bootstrapped by start-infra) --
APP_RW_PASSWORD=
CRAWLER_RW_PASSWORD=
AGGREGATOR_PASSWORD=
MIGRATOR_PASSWORD=

# --- Postgres: connection strings, one per role -----------------------------
# api + worker (all module schemas; market is read-only except the documented
# exceptions in docs/architecture.md section 3)
DATABASE_URL=
# crawler: market shared zone only, no access to any user schema
CRAWLER_DATABASE_URL=
# Alembic
MIGRATOR_DATABASE_URL=
# Connections each process keeps. When the edge and the compute side share one
# Postgres, take 2 or 3 in both places.
DB_POOL_SIZE=5
DB_STATEMENT_TIMEOUT_MS=30000

# --- Tunnel: the edge and the compute side (the `tunnel` profile only) ------
# Tailscale. Left blank where no tunnel runs. Where one does, both are required:
# an auth key from the admin console (Settings -> Keys; reusable, tagged, no
# expiry for a server), and this machine's name on the tailnet. On the compute
# side POSTGRES_HOST and the three database URLs name the edge's tunnel
# address (100.x.y.z), port 5432.
TUNNEL_AUTH_KEY=
TUNNEL_HOSTNAME=
# Seconds the compute side waits for Postgres to answer across the tunnel.
TUNNEL_WAIT_SECONDS=60

# --- The edge proxy (the `proxy` profile only; ADR 0053) ----------------------
# The site's name, which Caddy gets a Let's Encrypt certificate for, and the
# origin every public URL below uses (https://$SITE_HOSTNAME). Until there is a
# domain: <droplet-ip>.sslip.io. Blank where no proxy runs; required where one
# does.
SITE_HOSTNAME=
# The largest request body: above RESUME_MAX_BYTES, for multipart's framing.
EDGE_MAX_BODY_SIZE=11MB
# Requests per minute from one address: to /api/v1/auth/*, where every
# sign-in runs Argon2id; and to everything. Keep the second generous, because
# the SPA polls /activity every two seconds while work runs.
EDGE_AUTH_REQUESTS_PER_MINUTE=10
EDGE_REQUESTS_PER_MINUTE=300
# How long a client may take over its headers and its body, and stay idle.
EDGE_READ_HEADER_TIMEOUT=10s
EDGE_READ_BODY_TIMEOUT=120s
EDGE_IDLE_TIMEOUT=2m

# --- Database backups (make backup-db / restore-db; where Postgres runs) ----
# A bucket of its own, with a key only for it: the app's S3 key cannot reach
# the backups, and these cannot reach the app's files. A lifecycle rule on the
# bucket decides how long dumps are kept. Blank where no backup is taken.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Auth: our own sign-in ---------------------------------------------------
# Signs and verifies session tokens. At least 32 characters of randomness —
# rotating it signs everyone out, which is the intended emergency control.
AUTH_JWT_SECRET=
AUTH_TOKEN_ISSUER=job-searching-advisor
AUTH_TOKEN_AUDIENCE=job-searching-advisor-api
# Short: an access token cannot be revoked before it expires.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# false only for local http; the refresh cookie must not cross plain HTTP.
AUTH_COOKIE_SECURE=false

# --- Login OAuth: sign in with Google (optional; separate from connectors) --
# Off while GOOGLE_OAUTH_CLIENT_ID is blank, and the sign-in screen then offers
# email and password only. Once it is set, every value below is required and
# the api refuses to start without it (docs/decisions/0008).
#
# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# credentials -> OAuth client ID -> Web application. Under "Authorized redirect
# URIs" add exactly:
#
#   ${AUTH_PUBLIC_API_BASE_URL}/api/v1/auth/google/callback
#
# Locally that is http://localhost:21470/api/v1/auth/google/callback. The
# consent screen needs only the non-sensitive "openid" and "email" scopes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google's published endpoints, which come from configuration like every other
# URL, so a test double can stand in for them:
#   https://accounts.google.com/o/oauth2/v2/auth
#   https://oauth2.googleapis.com/token
#   https://www.googleapis.com/oauth2/v3/certs
GOOGLE_OAUTH_AUTHORIZE_URL=
GOOGLE_OAUTH_TOKEN_URL=
GOOGLE_OAUTH_JWKS_URL=
# Where a browser reaches the API, because Google sends the browser back to
# the API rather than to the SPA. Locally: http://localhost:21470
# (API_PUBLISHED_PORT). After a sign-in the browser returns to the SPA at
# OAUTH_REDIRECT_BASE_URL.
AUTH_PUBLIC_API_BASE_URL=

# --- Encryption -------------------------------------------------------------
# Base64-encoded 32-byte master key. Wraps the per-record data keys.
# Set on `api` and `worker` ONLY — never on `crawler`.
MASTER_ENCRYPTION_KEY=

# --- Object storage (MinIO locally, S3-compatible elsewhere) ----------------
# Where the services reach it, on the container network.
S3_ENDPOINT_URL=
# Where a browser reaches it. Presigned URLs are signed against this host, so
# it must be the address the client can actually resolve.
# Locally: http://localhost:21473 (S3_PUBLISHED_PORT).
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# --- Connector OAuth (separate from login OAuth) ----------------------------
# GitHub and Jira need an OAuth app registered with them; the values below come
# from that registration. Each provider must list this exact callback URL:
#
#   ${OAUTH_REDIRECT_BASE_URL}/connections/github/callback
#   ${OAUTH_REDIRECT_BASE_URL}/connections/jira/callback
#
# GitHub:  github.com/settings/developers -> OAuth Apps -> New OAuth App.
# Jira:    developer.atlassian.com/console/myapps -> Create -> OAuth 2.0
#          integration. Under Permissions add the Jira API with read:jira-work
#          and read:jira-user; under Authorization set the callback URL above.
#
# This is the SPA's origin, not the API's: the provider sends the browser back
# with a GET, and only the SPA holds the access token needed to finish the
# exchange. Locally: http://localhost:21471 (WEB_PUBLISHED_PORT).
OAUTH_REDIRECT_BASE_URL=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_API_BASE_URL=
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
JIRA_API_BASE_URL=
JIRA_OAUTH_BASE_URL=

# --- AI gateway -------------------------------------------------------------
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_RETRIES=2
AI_DEFAULT_MONTHLY_BUDGET_USD=20

# --- Uploads / parsing limits ------------------------------------------------
RESUME_MAX_BYTES=10485760
RESUME_MAX_PAGES=30
OWN_POSTING_MAX_BYTES=5242880
OWN_POSTING_MAX_PAGES=10
PARSE_TIMEOUT_SECONDS=60

# --- Résumé templates ----------------------------------------------------------
# How many templates of their own each user may keep (ADR 0040).
RESUME_TEMPLATE_MAX=10
# A PDF a template starts from, read for its style only (ADR 0041).
TEMPLATE_UPLOAD_MAX_BYTES=5242880
TEMPLATE_UPLOAD_MAX_PAGES=3

# --- Crawler ----------------------------------------------------------------
CRAWL_USER_AGENT="JobSearchingAdvisorBot/1.0 (+contact in robots policy)"
CRAWL_HTTP_TIMEOUT_SECONDS=30
CRAWL_RATE_LIMIT_PER_HOST_PER_SECOND=1
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# --- Market on demand (ADR 0027) ---------------------------------------------
# The market is fetched only when a role-map build needs it. All optional.
# Seconds between the crawler's looks for sources a build is waiting for.
CRAWL_DUE_POLL_SECONDS=15
# Requests to one host in one day, whatever the demand.
CRAWL_MAX_REQUESTS_PER_HOST_PER_DAY=500
# Hours a fetch is reused by any build: a job-API search, and a company board.
MARKET_SEARCH_FRESH_HOURS=72
MARKET_BOARD_FRESH_HOURS=24
# Seconds a build waits for its sources before starting on what is stored.
# Must be shorter than JOB_STALE_AFTER_SECONDS.
MARKET_WAIT_SECONDS=300
# Days before a search no build has needed is retired, and before a posting
# nothing holds loses its description and embedding.
MARKET_SOURCE_IDLE_DAYS=90
POSTING_THIN_AFTER_DAYS=180

# --- Assessment -------------------------------------------------------------
ASSESSMENT_CONFIDENCE_THRESHOLD=0.6

# --- Role map (ADR 0029) ------------------------------------------------------
# How many roles an analysis recommends; each is searched for in every country
# or "Remote" the user picked. 1 to 20.
ROLE_CANDIDATE_COUNT=10
# How many of them a build keeps, names, analyses and scores on the user's key
# (three calls each), and the whole map. At most ROLE_CANDIDATE_COUNT.
ROLE_MAP_TOP_K=10

# --- Background work ----------------------------------------------------------
# Seconds a sync, parse, analysis or role-map build may show as running before
# it is reported as lost and stops blocking the stages after it.
JOB_STALE_AFTER_SECONDS=900
# Seconds between the worker's and the crawler's heartbeats (ADR 0052). One
# silent for four of them reads as away: work waits for it rather than being
# reported lost, and the SPA says processing is offline.
PRESENCE_HEARTBEAT_SECONDS=10

# --- SPA runtime config (reaches the browser — never put a secret here) ------
# Locally: http://localhost:21470 (API_PUBLISHED_PORT).
WEB_API_BASE_URL=
